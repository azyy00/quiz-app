# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key. Used by API routes for scoring and game control. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the app (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Enables the "Generate with AI" quiz creator.
# Free key from https://aistudio.google.com (Get API key) — no credit card.
GEMINI_API_KEY=your-gemini-api-key
